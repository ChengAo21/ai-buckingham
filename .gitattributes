# Preserve exact evidence and source fingerprint bytes on every platform.
# This disables newline conversion, while ordinary text diffs still work.
* -text
*.png binary
*.pdf binary
*.npz binary
*.mat binary
*.ipynb -text
# Historical evidence has its own byte-preserving .gitattributes.
reproduction/rag_ablation/** -text
reproduction/regime_comparison/data/** -text
reproduction/regime_comparison/results/** -text
reproduction/velocity_comparison/data/** -text
reproduction/velocity_comparison/results/** -text
data/datasets/** -text
knowledge/*.md -text
